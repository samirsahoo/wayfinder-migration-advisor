# Wayfinder runs with zero configuration -- the defaults below are what
# you get out of the box. Copy this file to .env (and load it, e.g. with
# `python -m dotenv run -- wayfinder run ...` or your shell's export) only
# if you want real LLM-generated narration instead of the deterministic
# offline narrator.

# mock (default, no key needed) | anthropic
WAYFINDER_LLM_PROVIDER=mock

# Only read when WAYFINDER_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# WAYFINDER_LLM_MODEL=claude-sonnet-4-5
